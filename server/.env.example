# Asistan sunucusu yapılandırması. Bu dosyayı .env olarak kopyalayın; .env depoya eklenmez.
# API anahtarı yalnız sunucuda tutulur; VITE_* değişkenine veya tarayıcı koduna KOYMAYIN.

# Sağlayıcı: şimdilik 'anthropic' (resmî SDK). 'none' → sunucu yapılandırılmamış sayılır, site yerel rehberle çalışır.
ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model ve çıktı sınırları
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
ASSISTANT_MAX_TOKENS=4000
ASSISTANT_TIMEOUT_MS=20000
# Model bir isteği güvenlik nedeniyle reddederse sunucu tarafı yedek modele geçiş (on/off)
ASSISTANT_FALLBACKS=on

# İstek sınırlaması
ASSISTANT_RATE_PER_MIN=10
ASSISTANT_MAX_CONCURRENT=4

# Sunucu
PORT=8787
HOST=127.0.0.1
ASSISTANT_BASE_PATH=/api/assistant
# Statik site başka bir kökenden (ör. GitHub Pages) çağıracaksa izin verilen kökenler, virgülle:
ASSISTANT_ALLOWED_ORIGINS=
